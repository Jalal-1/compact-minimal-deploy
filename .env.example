# Preprod uses Blockfrost. Create a Midnight Preprod project at https://blockfrost.io.
# The project ID stays private; the scripts add it to the three network URLs.
NETWORK_ID=preprod
BLOCKFROST_PROJECT_ID=
INDEXER_HTTP_URL=https://midnight-preprod.blockfrost.io/api/v0
INDEXER_WS_URL=wss://midnight-preprod.blockfrost.io/api/v0/ws
NODE_WS_URL=wss://rpc.midnight-preprod.blockfrost.io
PROOF_SERVER_URL=http://127.0.0.1:6300

# npm run setup generates a fresh test wallet and fills the blank secrets below.
# Existing nonempty values are preserved. Keep .env private.
# Wallet master seed: 32 or 64 bytes in hexadecimal (not a mnemonic).
# Run npm run address to print the unshielded address (account 0, key index 0).
# Fund it at https://faucet.preprod.midnight.network/, then run npm run register-dust.
WALLET_SEED=

# Independent 32-byte owner secret nonce (64 hex characters).
OWNER_NONCE=

# Ledger 8 SigningKey generated using sampleSigningKey(), not a wallet seed.
CMA_SIGNING_KEY=

# 16+ characters; at least 3 of uppercase/lowercase/digits/symbols.
# Keep this secret. Used to encrypt the SDK's local signing-key store.
PRIVATE_STORAGE_PASSWORD=
