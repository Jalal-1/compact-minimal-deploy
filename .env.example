# Ledger 8 preprod endpoints from the pinned Midnight.js v4.1.1 configuration.
NETWORK_ID=preprod
INDEXER_HTTP_URL=https://indexer.preprod.midnight.network/api/v4/graphql
INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
NODE_WS_URL=wss://rpc.preprod.midnight.network
PROOF_SERVER_URL=http://127.0.0.1:6300

# Existing test wallet master seed, 32 or 64 bytes in hexadecimal (not a mnemonic).
# Must already have usable DUST; derivation uses account 0, key index 0.
WALLET_SEED=

# Independent 32-byte owner secret nonce (64 hex characters).
OWNER_NONCE=

# Ledger 8 SigningKey generated using sampleSigningKey(), not a wallet seed.
CMA_SIGNING_KEY=

# 16+ characters; at least 3 of uppercase/lowercase/digits/symbols.
# Keep this secret. Used to encrypt the SDK's local signing-key store.
PRIVATE_STORAGE_PASSWORD=
